# Copy to .env.production and replace every placeholder before deploying.
POSTGRES_DB=ssdd_agent
POSTGRES_USER=ssdd_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
# DB_* is set from POSTGRES_* by docker-compose.prod.yml; keep these only for non-Compose local runs.
DB_NAME=ssdd_agent
DB_USER=ssdd_app
DB_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
MINIO_ROOT_USER=ssdd_minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
MINIO_ACCESS_KEY=ssdd_minio
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
MINIO_BUCKET=ssdd-images
JWT_SECRET_KEY=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_SECRET
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ALLOWED_ORIGINS=https://your-domain.example
APP_PORT=8080
DEBUG=false

BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
PASSWORD_RESET_URL=https://your-domain.example/login

BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
PASSWORD_RESET_URL=https://your-domain.example/login
