OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Embedding（RAG 向量检索，默认复用上面的 OPENAI_* 配置，如需换供应商再单独覆盖）
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

QWEN_API_KEY=sk-your-qwen-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ssdd_agent
DB_USER=admin
DB_PASSWORD=admin
DATABASE_URL=postgresql://admin:admin@localhost:5432/ssdd_agent

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

USE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ssdd-images
MINIO_SECURE=false

JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

APP_NAME=SSDD: Steel Defect Agent
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Training paths (relative to the project root by default)
DATASET_BASE_DIR=datasets/ssdd
TRAIN_OUTPUT_DIR=runs/train

BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
